# Secret key used for cryptographic signing. Required, with no fallback.
# Generate with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Paste the result inside the single quotes below.
DJANGO_SECRET_KEY=''

# Enables debug mode. Set to '0' in production.
# Must be '0' or '1'; settings default to '0'. This is set to '1' for local development.
DJANGO_DEBUG=1

# A comma-separated list of allowed hosts and domains.
# Defaults to 'localhost,127.0.0.1' when unset.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Path to the SQLite file, resolved against the project directory if relative.
# Defaults to 'data/db.sqlite3' when unset.
DATABASE_NAME=data/db.sqlite3
