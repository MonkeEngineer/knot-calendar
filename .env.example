# Copy this file to .env and fill in the values.
# Load it through uv: uv run --env-file .env ...
# or set UV_ENV_FILE=.env in your shell.
# The app never loads .env itself.

# Required. Generate with:
# uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Wrap the value in single quotes if it contains # or $.
SECRET_KEY='your-secret-key-here'

# Optional. Defaults to False (off). Set to True for local development.
# DEBUG=True

# Optional. Comma-separated list of allowed hostnames. Defaults to empty (localhost allowed when DEBUG=True).
# ALLOWED_HOSTS=localhost,127.0.0.1

# Optional. Defaults to INFO. Controls the minimum log level for all app loggers.
# LOG_LEVEL=DEBUG

# Optional. Defaults to a local SQLite file (db.sqlite3) at the repo root.
# To use PostgreSQL, set this to a postgres:// URL, e.g.:
# DATABASE_URL=postgres://user:password@localhost:5432/knot_calendar
